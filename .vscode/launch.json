// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "生成文件模板",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extension/create-template"],
      "outFiles": ["${workspaceFolder}/extension/create-template/out/**/*.js"],
      "cwd": "${workspaceFolder}/extension/create-template",
      "preLaunchTask": "npm: compile - extension/create-template"
    }
  ]
}
