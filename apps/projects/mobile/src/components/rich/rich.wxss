.wxe-editor-container {
  border: 1px solid #ccc;
  border-radius: 8px;
  overflow: hidden;
  background: #fff;
  max-height: 90vh;
}

.wxe-editor-toolbar {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  padding: 8px 10px;
  background-color: #f5f5f5;
  border-bottom: 1px solid #ddd;
  align-items: center;
}

.wxe-editor-icon {
  width: 16px;
  height: 16px;
}

.wxe-editor-content {
  min-height: 450px;
  padding: 16px;
  font-size: 15px;
  box-sizing: border-box;
  line-height: 1.6;
}
