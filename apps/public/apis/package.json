{
  "name": "@apps/apis",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "main": "src/index.ts",
  "sideEffects": false,
  "engines": {
    "npm": ">=3.0.0"
  },
  "scripts": {
    "test": "vitest",
    "api": "node ./pullYapiToken --force && node ../../../node_modules/@linkseeks/yapi2ts/libs/cli.js",
    "api-force": "node ./pullYapiToken --force && node ../../../node_modules/@linkseeks/yapi2ts/libs/cli.js",
    "deploy": "node ./scripts/deploy && pnpm api",
    "build": "rimraf -rf lib esm && npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc --project tsconfig.build.json --outDir lib",
    "build:esm": "tsc --project tsconfig.build.json --module es2015 --outDir esm",
    "build:umd": "rollup --config"
  },
  "publishConfig": {
    "registry": "http://npm.shushangyun.com"
  },
  "devDependencies": {
    "axios": "^1.3.5",
    "fs-extra": "^11.1.0"
  },
  "dependencies": {
    "msw": "^1.2.1",
    "@tarojs/taro": "3.6.23"
  }
}
