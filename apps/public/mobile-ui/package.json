{
  "name": "@apps/mobile-ui",
  "version": "1.0.0",
  "main": "packages/index.ts",
  "source": "packages/index.ts",
  "description": "taro-ui",
  "types": "types/index.d.ts",
  "files": [
    "lib",
    "dist",
    "types"
  ],
  "scripts": {
    "dev": "yarn run dev:lib",
    "dev:lib": "tsc --project ./tsconfig.build.json --watch --incremental",
    "build": "yarn run build:es && yarn run build:lib",
    "build:es": "tsc --project ./tsconfig.build.json --declaration --declarationDir types",
    "build:lib": "tsc --project ./tsconfig.build.json --target es5 --module es2015 --outDir lib --declaration --declarationDir types",
    "build:rollup": "rollup --config ./rollup.config.js",
    "lint": "eslint ./packages --fix",
    "lint:style": "stylelint \"packages/**/*.scss\" --syntax scss",
    "lint:style-fix": "stylelint \"packages/**/*.scss\" --syntax scss --fix",
    "test": "cross-env NODE_ENV=test && jest --coverage",
    "test:ci": "yarn run build:h5 && yarn run test",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "clean": "rimraf .temp dist lib coverage",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "dependencies": {
    "lodash": "^4.17.21",
    "@types/lodash": "^4.14.191",
    "@react-spring/web": "9.7.3",
    "@use-gesture/react": "^10.2.6",
    "dayjs": "^1.10.7"
  },
  "devDependencies": {
    "@babel/core": "^7.8.0",
    "@babel/runtime": "^7.7.7",
    "@rollup/plugin-commonjs": "^13.0.0",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^8.0.1",
    "@tarojs/cli": "3.6.23",
    "@tarojs/plugin-framework-react": "3.6.23",
    "@tarojs/components": "3.6.23",
    "@tarojs/mini-runner": "3.6.23",
    "@tarojs/webpack5-runner": "3.6.23",
    "@tarojs/react": "3.6.23",
    "@tarojs/runtime": "3.6.23",
    "@tarojs/taro": "3.6.23",
    "@tarojs/plugin-platform-weapp": "3.6.23",
    "@tarojs/plugin-platform-h5": "3.6.23",
    "@tarojs/shared": "3.6.23",
    "@types/prop-types": "^15.7.5",
    "@types/react": "^17.0.0",
    "@types/uuid": "^8.3.1",
    "@types/webpack-env": "^1.13.6",
    "@typescript-eslint/eslint-plugin": "^4.15.1",
    "@typescript-eslint/parser": "^4.15.1",
    "babel-preset-taro": "3.6.23",
    "bind-decorator": "^1.0.11",
    "eslint": "^6.8.0",
    "eslint-config-taro": "3.6.23",
    "eslint-plugin-import": "^2.12.0",
    "eslint-plugin-react": "^7.8.2",
    "eslint-plugin-react-hooks": "^4.2.0",
    "prop-types": "15.8.1",
    "rollup": "^2.16.1",
    "rollup-plugin-copy": "^3.3.0",
    "rollup-plugin-typescript2": "^0.27.1",
    "rollup-plugin-visualizer": "^4.0.4",
    "stylelint": "9.3.0",
    "stylelint-config-standard": "^22.0.0",
    "stylelint-scss": "^3.21.0",
    "tslib": "^2.3.1",
    "typescript": "^4.1.0",
    "babel-plugin-import": "^1.13.3"
  },
  "peerDependencies": {
    "dayjs": "^1.10.7",
    "react": ">=16.13.0",
    "react-dom": ">=16.13.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "http://npm.shushangyun.com"
  }
}
