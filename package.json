{
  "name": "linkseeks-web",
  "version": "0.1.15",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "root": true,
  "scripts": {
    "build": "pnpm run build",
    "dev": "pnpm run dev",
    "lint": "pnpm run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx}\"",
    "clean:all": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "test": "pnpm test",
    "prepare": "husky install",
    "build:micro": "pnpm --filter=@micro/* build",
    "api": "pnpm --filter=@apps/apis api",
    "start:docs": "pnpm dev --filter @linkseeks/docs",
    "start:components": "pnpm --filter=@apps/components dev",
    "start:mall": "pnpm --filter @projects/mall dev",
    "start:mall-platform": "pnpm --filter @projects/mall-platform dev",
    "start:platform": "pnpm --filter @projects/platform dev",
    "start:admin": "pnpm --filter @projects/admin dev",
    "start:weapp": "pnpm --filter @projects/mobile dev:weapp",
    "start:h5": "pnpm --filter=@projects/mobile dev:h5",
    "start:im": "pnpm --filter=@projects/im dev",
    "start:srm-weapp": "pnpm --filter @projects/mobile-srm dev:weapp",
    "start:srm-h5": "pnpm --filter=@projects/mobile-srm dev:h5",
    "start:sale-weapp": "pnpm --filter @projects/mobile-sale dev:weapp",
    "start:sale-h5": "pnpm --filter=@projects/mobile-sale dev:h5",
    "test:platform": "npx cross-env ENV_TYPE=test pnpm start:platform",
    "test:admin": "npx cross-env ENV_TYPE=test pnpm start:admin",
    "test:mall": "npx cross-env ENV_TYPE=test pnpm start:mall",
    "test:weapp": "npx cross-env ENV_TYPE=test pnpm start:weapp",
    "test:h5": "npx cross-env ENV_TYPE=test pnpm start:h5",
    "test:im": "npx cross-env ENV_TYPE=test pnpm start:im",
    "test:sale-weapp": "npx cross-env ENV_TYPE=test pnpm start:sale-weapp",
    "test:srm-weapp": "npx cross-env ENV_TYPE=test pnpm start:srm-weapp",
    "uat:platform": "npx cross-env ENV_TYPE=uat pnpm start:platform",
    "uat:admin": "npx cross-env ENV_TYPE=uat pnpm start:admin",
    "uat:weapp": "npx cross-env ENV_TYPE=uat pnpm start:weapp",
    "uat:h5": "npx cross-env ENV_TYPE=uat pnpm start:h5",
    "prod:platform": "npx cross-env ENV_TYPE=prod pnpm start:platform",
    "prod:admin": "npx cross-env ENV_TYPE=prod pnpm start:admin",
    "prod:mall": "npx cross-env ENV_TYPE=prod pnpm start:mall",
    "prod:weapp": "npx cross-env ENV_TYPE=prod pnpm start:weapp",
    "prod:h5": "npx cross-env ENV_TYPE=prod pnpm start:h5",
    "build:admin": "pnpm --filter=@projects/admin build",
    "build:platform": "pnpm --filter=@projects/platform build",
    "prod-build:admin": "npx cross-env ENV_TYPE=prod pnpm --filter=@projects/admin build",
    "prod-build:platform": "npx cross-env ENV_TYPE=prod pnpm --filter=@projects/platform build",
    "build:weapp": "pnpm --filter=@projects/mobile build --type weapp",
    "test-build:weapp": "npx cross-env ENV_TYPE=test pnpm --filter=@projects/mobile build --type weapp",
    "uat-build:weapp": "npx cross-env ENV_TYPE=uat pnpm --filter=@projects/mobile build --type weapp",
    "prod-build:weapp": "npx cross-env ENV_TYPE=prod pnpm --filter=@projects/mobile build --type weapp",
    "build:h5": "pnpm --filter=@projects/mobile build --type h5",
    "build:im": "pnpm --filter=@projects/im build",
    "build-upload:weapp-sale": "pnpm --filter=@projects/mobile-sale build:weapp:upload",
    "build-upload:weapp-srm": "pnpm --filter=@projects/mobile-srm build:weapp:upload",
    "build-upload:weapp-mall": "pnpm --filter=@projects/mobile build:weapp:upload",
    "build:mall": "pnpm --filter=@projects/mall build",
    "build:sale-weapp": "pnpm --filter=@projects/mobile-sale build --type weapp",
    "prod-build:sale-weapp": "npx cross-env ENV_TYPE=prod pnpm --filter=@projects/mobile-sale build --type weapp",
    "preview:mall": "pnpm --filter=@projects/mall preview",
    "publish:patch": "standard-version",
    "preWorkInstall": "cd scripts && pnpm preWorkInstall"
  },
  "devDependencies": {
    "@tarojs/plugin-mini-ci": "^4.1.2",
    "@types/jest": "^27.5.2",
    "@types/node": "^20.2.3",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@types/react-helmet": "^6.1.6",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@types/uuid": "^9.0.2",
    "conventional-changelog-cli": "^4.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.3.0",
    "eslint-config-prettier": "^8.8.0",
    "http-proxy-middleware": "^2.0.6",
    "husky": "^8.0.3",
    "jest-dom": "link:@types/@testing-library/jest-dom",
    "less": "^4.1.3",
    "less-loader": "^11.1.0",
    "lint-staged": "^13.2.0",
    "matchers": "link:@types/@testing-library/jest-dom/matchers",
    "miniprogram-ci": "^2.1.14",
    "postcss-less": "^6.0.0",
    "prettier": "2.8.6",
    "standard-version": "^9.5.0",
    "stylelint-config-standard": "^31.0.0",
    "typescript": "^4.9.5",
    "vite-plugin-entry-shaking": "^0.2.1"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "@linkseeks/crypto": "workspace:^1.0.0",
    "@linkseeks/hooks": "workspace:^1.0.0",
    "@linkseeks/i18n": "workspace:^1.0.0",
    "@linkseeks/icons": "workspace: *",
    "@linkseeks/request": "workspace:^1.0.0",
    "@linkseeks/router": "workspace:^1.0.0",
    "@linkseeks/router-core": "workspace:^1.0.0",
    "@linkseeks/router-manager": "workspace:^1.0.0",
    "@linkseeks/standard": "workspace:^1.0.0",
    "@linkseeks/storage": "workspace:*",
    "@linkseeks/tools": "workspace:^1.0.0",
    "@linkseeks/ui": "workspace:^1.0.0",
    "@linkseeks/yapi2ts": "workspace:^1.0.0",
    "@neysf/qiyu-web-sdk": "^1.1.4",
    "@tencentcloud/chat-uikit-engine": "latest",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "^13.4.0",
    "@types/lodash": "^4.14.191",
    "@typescript-eslint/parser": "^5.57.0",
    "@vitejs/plugin-react": "^4.0.0",
    "antd": "4.24.10",
    "classnames": "^2.3.2",
    "clone": "^2.1.2",
    "css-vars-ponyfill": "^2.4.8",
    "dayjs": "^1.11.13",
    "hel-micro": "^4.6.3",
    "jest": "^27.4.3",
    "lodash": "^4.17.21",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet": "^6.1.0",
    "reflect-metadata": "^0.1.13",
    "slate": "^0.94.1",
    "slate-react": "^0.99.0",
    "stylelint": "^15.3.0",
    "test-config": "workspace:^1.0.0",
    "tsconfig": "workspace:*",
    "uuid": "^9.0.0",
    "vite": "6.1.1",
    "vite-plugin-svgr": "^3.2.0",
    "vitest": "3.0.1"
  },
  "resolutions": {
    "d3-interpolate": "1.4.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --ext js,jsx,ts,tsx --quiet --fix --",
      "prettier --write"
    ],
    "*.{json,less,md,css}": [
      "prettier --write"
    ],
    "**/*.{css,less}": [
      "stylelint --fix"
    ]
  },
  "packageManager": "pnpm@10.4.1",
  "config": {
    "commitizen": {
      "path": "packages/scripts/cz-emoji-conventional/index.js"
    }
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1"
    }
  }
}
